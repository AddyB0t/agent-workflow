# LLM: any OpenAI-compatible endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini

# Code sandbox and web search
E2B_API_KEY=
TAVILY_API_KEY=

# Postgres: leave empty to start an embedded server (pgserver) under ./.pgdata
DATABASE_URL=

# OpenTelemetry: spans go to traces/spans.jsonl; set an OTLP endpoint (e.g. Jaeger) to also export there
OTEL_EXPORTER_OTLP_ENDPOINT=

# Guardrails (per run)
MAX_STEPS=25
MAX_COST_USD=0.10
MAX_TOKENS=200000
SANDBOX_TIMEOUT_S=60
MAX_FIX_ATTEMPTS=3
